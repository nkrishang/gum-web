# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Privy (dashboard.privy.io → your app → App settings). Required for sign-in.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional. Only if you created a dedicated web client in Privy.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# gum-server. The browser never calls this directly; /api/gum proxies to it.
GUM_API_URL=https://api.gum.money
# Shown in code snippets on the site.
NEXT_PUBLIC_GUM_API_URL=https://api.gum.money

# Used for absolute Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://gum.money
